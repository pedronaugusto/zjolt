.{
    .name = .zjolt,
    .version = "0.2.0",
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0xfc700587694304e3,
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "ffi",
        "libs",
        "src",
        "tests",
        // Contributing tells people to run ci/run.sh before pushing, so a
        // fetched copy has to actually contain it, and the workflow it mirrors.
        "ci",
        "tools",
        ".github",
        "LICENSE",
        // Every markdown file the package ships. README.md links all of
        // them, so one left out of this list is a dead link in a fetched
        // copy rather than a missing convenience.
        "BINDING.md",
        "CHANGELOG.md",
        "README.md",
        "UPSTREAM.md",
    },
}
